# Engine
COMFY_URL=http://127.0.0.1:8188
COMFY_OUTPUT_DIR=/srv/ComfyUI/output

# Model files (names inside ComfyUI/models)
# Primary path: the distilled FLUX.2-Klein-4B (the build Bonsai Image 4B is
# quantized from) as a 2-bit Q2_K GGUF via molbal's UnetLoaderGGUF.
#   (Bonsai's 1-bit Q1_0 file cannot be dequantized by any current toolchain.)
# Fallback, if the GGUF arch detection rejects the build on this host:
#   ANOTHERLAB_UNET_LOADER=UNETLoader
#   ANOTHERLAB_UNET=flux-2-klein-4b.safetensors   (7.75 GB fp16, distilled)
ANOTHERLAB_UNET=flux-2-klein-4b-Q2_K.gguf
ANOTHERLAB_UNET_LOADER=UnetLoaderGGUF
ANOTHERLAB_CLIP=qwen_3_4b_fp4_flux2.safetensors
ANOTHERLAB_CLIP_TYPE=flux2
ANOTHERLAB_VAE=flux2-vae.safetensors
ANOTHERLAB_SAMPLER=euler
# The model is distilled: CFG is fixed at 1, 4 steps is its native pace.
ANOTHERLAB_DEVICE_LABEL=CPU · 8 vCPU
# Multiply the rough ETA; calibrate with `make trial`
ANOTHERLAB_ETA_SCALE=1

# Defaults and limits
ANOTHERLAB_DEFAULT_WIDTH=512
ANOTHERLAB_DEFAULT_HEIGHT=512
ANOTHERLAB_DEFAULT_STEPS=4
ANOTHERLAB_DEFAULT_CFG=1.0
ANOTHERLAB_MAX_STEPS=20
ANOTHERLAB_MAX_DIMENSION=1024
ANOTHERLAB_MIN_DIMENSION=256

# Images self-destruct this many seconds after they are ready
ANOTHERLAB_TTL_SECONDS=300
ANOTHERLAB_JOB_TIMEOUT=3600

# Server
ANOTHERLAB_DATA_DIR=/srv/anotherlab/data
ANOTHERLAB_HOST=0.0.0.0
ANOTHERLAB_PORT=8080
ANOTHERLAB_API_KEY=
ANOTHERLAB_PUBLIC_URL=
ANOTHERLAB_CORS_ORIGINS=*
