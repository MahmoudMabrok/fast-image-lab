[Unit]
Description=ComfyUI engine for AnotherLab (Bonsai Image 4B)
After=network.target

[Service]
Type=simple
WorkingDirectory=/srv/ComfyUI
Environment=PYTHONUNBUFFERED=1
Environment=OMP_NUM_THREADS=8
Environment=MALLOC_ARENA_MAX=2
ExecStart=/srv/ComfyUI/.venv/bin/python main.py \
  --listen 127.0.0.1 --port 8188 --cpu \
  --preview-method none --disable-auto-launch
Restart=always
RestartSec=5
TimeoutStopSec=30
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
